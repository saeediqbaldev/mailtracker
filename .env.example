# ---- App ----
PORT=3000
# Public HTTPS URL this app will be served at (set your Coolify domain here).
APP_BASE_URL=https://track.yourdomain.com

# Generate both of these with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string
API_KEY=change_this_to_a_long_random_string

# ---- Dashboard login (single admin user) ----
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change_this_password

# Seconds after sending during which pixel hits are ignored (filters out the
# sender's own Sent-folder preview auto-loading images). Optional, defaults to 8.
OPEN_GRACE_SECONDS=8

# ---- Postgres ----
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=mailtracker

# Keep this in sync with the three POSTGRES_* values above.
DATABASE_URL=postgres://tracker:change_this_password@db:5432/mailtracker

# ---- Email notifications (sent via your Zoho Mail account) ----
# These are just the FALLBACK values. You can set/override all of this,
# including turning the feature on/off and the destination address, from
# the Settings page in the dashboard once it's running — values entered
# there are stored in the DB and take priority over these env vars. Leave
# these filled in anyway so the feature works even before you visit
# Settings for the first time.
SMTP_HOST=smtp.zoho.com
# 465 = SSL (recommended). Use 587 if your Zoho org requires STARTTLS.
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
# Use a Zoho Mail App Password here (Zoho Account > Security > App Passwords),
# not your normal login password — required if two-factor auth is on.
SMTP_PASS=change_this_app_password
SMTP_FROM=you@yourdomain.com

# ---- WhatsApp notifications ----
# Not wired up yet. The Settings page has a placeholder for it; see the
# "WhatsApp notifications" section of README.md for how to add CallMeBot
# (free, personal number) or Twilio (paid, business-grade) later.
